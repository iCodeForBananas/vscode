  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#98A2B0", "fontStyle": "italic" }
    },
    {
      "scope": [
        "constant",
        "constant.other",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "entity.name.constant",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#79B8FF" }
    },
    {
      "scope": ["entity", "entity.name", "entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#D2A8FF" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component", "meta.tag.sgml"],
      "settings": { "foreground": "#7EE787" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class",
        "meta.type.annotation"
      ],
      "settings": { "foreground": "#56D4DD" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#FF8A82" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#C9CED6" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#A5D6FF" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape", "constant.other.character-class"],
      "settings": { "foreground": "#76E3EA" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.other.object", "meta.definition.variable"],
      "settings": { "foreground": "#E6E8EB" }
    },
    {
      "scope": ["variable.parameter", "variable.other.property", "variable.language", "variable.other.member"],
      "settings": { "foreground": "#E3B341" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "support.type.property-name"],
      "settings": { "foreground": "#F2CC60" }
    },
    {
      "scope": ["entity.name.tag.css", "support.type.property-name.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#D2A8FF" }
    },
    {
      "scope": ["support.constant.property-value.css", "constant.other.color"],
      "settings": { "foreground": "#A5D6FF" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#FFA198", "fontStyle": "italic underline" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#E2C5FF", "fontStyle": "italic underline" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name", "entity.name.section"],
      "settings": { "foreground": "#79B8FF", "fontStyle": "bold" }
    },
    { "scope": ["markup.bold"], "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#E6E8EB", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#6FD28A" } },
    { "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code.block"], "settings": { "foreground": "#A5D6FF" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#A5D6FF", "fontStyle": "underline" } },
    { "scope": ["markup.list", "beginning.punctuation.definition.list"], "settings": { "foreground": "#E3B341" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#7EE787" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#FFA198" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#F2CC60" } },
    { "scope": ["meta.diff.range", "punctuation.definition.range.diff"], "settings": { "foreground": "#D2A8FF", "fontStyle": "bold" } },
    { "scope": ["meta.diff.header"], "settings": { "foreground": "#79B8FF" } },
    { "scope": ["meta.separator"], "settings": { "foreground": "#79B8FF", "fontStyle": "bold" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#FF8A82" } },
    { "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"], "settings": { "foreground": "#79B8FF" } },
    { "scope": ["token.info-token"], "settings": { "foreground": "#79B8FF" } },
    { "scope": ["token.warn-token"], "settings": { "foreground": "#E3B341" } },
    { "scope": ["token.error-token"], "settings": { "foreground": "#FF8A82" } },
    { "scope": ["token.debug-token"], "settings": { "foreground": "#D2A8FF" } }
  ],
  "semanticTokenColors": {
    "parameter": "#E3B341",
    "property": "#E3B341",
    "enumMember": "#79B8FF",
    "namespace": "#56D4DD",
    "type": "#56D4DD",
    "class": "#56D4DD",
    "interface": "#56D4DD",
    "function": "#D2A8FF",
    "method": "#D2A8FF",
    "macro": "#FF8A82",
    "*.readonly": "#79B8FF",
    "variable.defaultLibrary": "#56D4DD"
  }
}
