  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#6E757E", "fontStyle": "italic" }
    },
    {
      "scope": [
        "constant",
        "constant.other",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "entity.name.constant",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#006FF1" }
    },
    {
      "scope": ["entity", "entity.name", "entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#8A33C8" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component", "meta.tag.sgml"],
      "settings": { "foreground": "#157A34" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class",
        "meta.type.annotation"
      ],
      "settings": { "foreground": "#0D7478" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#C21F2E" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#3F464E" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#0B5FD0" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape", "constant.other.character-class"],
      "settings": { "foreground": "#008288" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.other.object", "meta.definition.variable"],
      "settings": { "foreground": "#0A0C0E" }
    },
    {
      "scope": ["variable.parameter", "variable.other.property", "variable.language", "variable.other.member"],
      "settings": { "foreground": "#8A5A00" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "support.type.property-name"],
      "settings": { "foreground": "#A26800" }
    },
    {
      "scope": ["entity.name.tag.css", "support.type.property-name.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#8A33C8" }
    },
    {
      "scope": ["support.constant.property-value.css", "constant.other.color"],
      "settings": { "foreground": "#0B5FD0" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#E0132A", "fontStyle": "italic underline" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#A526F0", "fontStyle": "italic underline" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name", "entity.name.section"],
      "settings": { "foreground": "#0B5FD0", "fontStyle": "bold" }
    },
    { "scope": ["markup.bold"], "settings": { "foreground": "#000000", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#0A0C0E", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#157A34" } },
    { "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code.block"], "settings": { "foreground": "#0B5FD0" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#0B5FD0", "fontStyle": "underline" } },
    { "scope": ["markup.list", "beginning.punctuation.definition.list"], "settings": { "foreground": "#8A5A00" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#008736" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#E0132A" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#A26800" } },
    { "scope": ["meta.diff.range", "punctuation.definition.range.diff"], "settings": { "foreground": "#8A33C8", "fontStyle": "bold" } },
    { "scope": ["meta.diff.header"], "settings": { "foreground": "#0B5FD0" } },
    { "scope": ["meta.separator"], "settings": { "foreground": "#0B5FD0", "fontStyle": "bold" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#C21F2E" } },
    { "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"], "settings": { "foreground": "#006FF1" } },
    { "scope": ["token.info-token"], "settings": { "foreground": "#0B5FD0" } },
    { "scope": ["token.warn-token"], "settings": { "foreground": "#8A5A00" } },
    { "scope": ["token.error-token"], "settings": { "foreground": "#C21F2E" } },
    { "scope": ["token.debug-token"], "settings": { "foreground": "#8A33C8" } }
  ],
  "semanticTokenColors": {
    "parameter": "#8A5A00",
    "property": "#8A5A00",
    "enumMember": "#006FF1",
    "namespace": "#0D7478",
    "type": "#0D7478",
    "class": "#0D7478",
    "interface": "#0D7478",
    "function": "#8A33C8",
    "method": "#8A33C8",
    "macro": "#C21F2E",
    "*.readonly": "#006FF1",
    "variable.defaultLibrary": "#0D7478"
  }
}
